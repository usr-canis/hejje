    <!-- About -->
    <string name="about_meaning">“Hejje” is Kannada for footprint.</string>
    <string name="about_privacy_title">Your data</string>
    <string name="about_privacy">Trips are stored only on this phone. There are no accounts, no cloud, no analytics and no ads. The app uses the internet for three things only: map tiles, place names (if switched on) and checking for updates.</string>
    <string name="about_credits_title">Maps and place names</string>
    <string name="about_credits">Map tiles by OpenFreeMap, using the OpenMapTiles schema. Map data and place names © OpenStreetMap contributors, available under the Open Database License. Place names come from the Nominatim service.</string>
    <string name="about_link_osm">OpenStreetMap copyright</string>
    <string name="about_link_ofm">OpenFreeMap</string>
    <string name="about_link_source">Source code and releases</string>

    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Every drive, recorded for you</string>
    <string name="onboarding_welcome_body">Recording starts when your phone connects to your car and stops when it disconnects. Everything stays on this phone.</string>
    <string name="onboarding_start">Get started</string>
    <string name="onboarding_location_title">Allow location</string>
    <string name="onboarding_location_body">The app needs your precise location to draw the route and measure distance and speed. Choose “Precise” and “While using the app”.</string>
    <string name="onboarding_background_title">Allow it all the time</string>
    <string name="onboarding_background_body">Drives start while the phone is in your pocket and the app is closed. On the next screen choose “Allow all the time”. Location is only used while a drive is being recorded.</string>
    <string name="onboarding_background_action">Open location setting</string>
    <string name="onboarding_notifications_title">Allow notifications</string>
    <string name="onboarding_notifications_body">You will see a small notification while a drive is recorded, and a short summary afterwards.</string>
    <string name="onboarding_car_title">Choose your car</string>
    <string name="onboarding_car_body">Allow access to nearby devices, then pick your car from your paired Bluetooth devices.</string>
    <string name="onboarding_car_later">Choose later</string>
    <string name="onboarding_battery_title">Let it run in the background</string>
    <string name="onboarding_battery_body">Android puts unused apps to sleep, which would stop drives from being recorded. Tap the button and choose “Allow”.</string>
    <string name="onboarding_battery_action">Allow background use</string>
    <string name="onboarding_done_title">You are all set</string>
    <string name="onboarding_done_body">Take a drive and your trip appears on its own. You can review everything under Settings › Recording health.</string>
    <string name="onboarding_finish">Open the app</string>
    <string name="onboarding_skip">Skip for now</string>

